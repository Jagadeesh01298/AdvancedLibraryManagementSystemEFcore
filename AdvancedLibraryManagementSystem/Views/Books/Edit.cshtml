@model AdvancedLibraryManagementSystem.Models.Book

<h2>Edit Book</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="BookId" />

    <div class="form-group">
        <label>Book Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <br />

    <div class="form-group">
        <label>Published Year</label>
        <input asp-for="PublishedYear" class="form-control" />
    </div>

    <br />

    <div class="form-group">
        <label>Author</label>
        <select asp-for="AuthorId" asp-items="ViewBag.Authors" class="form-control"></select>
    </div>

    <br />

    <div class="form-group">
        <label>Genre</label>
        <select asp-for="GenreId" asp-items="ViewBag.Genres" class="form-control"></select>
    </div>

    <br />

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
