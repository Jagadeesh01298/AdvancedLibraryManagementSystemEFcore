@model IEnumerable<AdvancedLibraryManagementSystem.Models.Genre>

<h2>Genres</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add Genre</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Genre Name</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var genre in Model)
        {
            <tr>
                <td>@genre.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@genre.GenreId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@genre.GenreId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
